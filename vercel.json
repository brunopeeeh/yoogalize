{
  "functions": {
    "api/lojas.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "images": {
    "sizes": [64, 128, 640, 1080],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "cdn-production.yooga.com.br"
      }
    ]
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
