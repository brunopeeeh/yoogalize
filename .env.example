# =============================================================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA comite um arquivo ".env" real.
# =============================================================================

# Chave de acesso do Mapbox (geocodificacao de enderecos e CEP).
# Dashboard: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN="sua_chave_de_acesso_mapbox"

# --- Opcional: conexao com o Postgres do Raspberry Pi -------------------
# Usado apenas pelos scripts em tools/ (carga e auditoria). Nao e usado
# pelo front-end em tempo de execucao.
#
# Conexao local (peer auth, sem senha):
#   psql -h /var/run/postgresql -U postgres -d bruno_db
# Conexao via TCP (exige senha do role):
#   DATABASE_URL="postgresql://bruno_app:SUA_SENHA@192.168.1.7:5432/bruno_db"
